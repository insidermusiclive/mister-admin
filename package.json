{
  "name": "mister-admin",
  "version": "1.0.0",
  "description": "Mister Admin - a content admin for static websites, one click to install in your own Cloudflare account",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mister-admin --local",
    "db:migrate:remote": "wrangler d1 migrations apply mister-admin --remote",
    "test": "node --test test/run.js"
  },
  "devDependencies": {
    "wrangler": "^4.146.0"
  }
}
